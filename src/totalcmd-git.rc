#include <winver.h>

#define GP_VERSION     1,0,0,0
#define GP_VERSION_STR "1.0.0"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    GP_VERSION
PRODUCTVERSION GP_VERSION
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Dmitry Samodov"
            VALUE "FileDescription",  "totalcmd-git: posh-git style git status for the Total Commander command line"
            VALUE "FileVersion",      GP_VERSION_STR
            VALUE "InternalName",     "totalcmd-git"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Dmitry Samodov, MIT License"
            VALUE "OriginalFilename", "totalcmd-git.wdx"
            VALUE "ProductName",      "totalcmd-git"
            VALUE "ProductVersion",   GP_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
